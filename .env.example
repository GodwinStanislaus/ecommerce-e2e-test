# Copy to .env (gitignored) and fill in. Never commit real values.
# Login for the account the suite runs as (needs admin/accounts role for cash and bank books).
E2E_MOBILE=
E2E_PASSWORD=
# Business to pick when the account belongs to several (business or legal name, case-insensitive substring). Optional.
E2E_BUSINESS=
# Defaults shown
# E2E_BASE_URL=http://localhost:4200
# E2E_API_URL=http://localhost:3000
# Set to 1 to also run firefox + webkit
# E2E_ALL_BROWSERS=
