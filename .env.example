# Copy to .env.<name> (gitignored via .env*) for each environment, e.g. .env.local, .env.test, .env.staging.
# Select with E2E_ENV=<name> (default: local). Shell variables override file values.
E2E_BASE_URL=http://localhost:4200
E2E_API_URL=http://localhost:3000
# Login of the account the suite runs as (needs admin/accounts role for cash and bank books).
E2E_MOBILE=
E2E_PASSWORD=
# Business to pick when the account has several (name substring, case-insensitive). Optional.
E2E_BUSINESS=
# Set to 1 to also run firefox + webkit
# E2E_ALL_BROWSERS=
# Cash/bank accounts and counter ledgers used by tests/books (defaults match the local dev DB; override per environment)
# E2E_CASH_ACCOUNT_ID=54
# E2E_CASH_ACCOUNT_NAME=Petty Cash
# E2E_BANK_ACCOUNT_ID=172
# E2E_BANK_ACCOUNT_NAME=Bank - Indian Bank
# E2E_RECEIPT_COUNTER_ID=88
# E2E_RECEIPT_COUNTER_NAME=Interest Received
# E2E_PAYMENT_COUNTER_ID=41
# E2E_PAYMENT_COUNTER_NAME=Freight Inbound
